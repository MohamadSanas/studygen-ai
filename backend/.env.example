# Application Configuration
APP_NAME=StudyGen AI
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# LLM Providers API Keys
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector DB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=models/embedding-001

# Relational Database (PostgreSQL / SQLite fallback for development)
DATABASE_URL=postgresql://user:password@localhost:5432/studygen_db
# Alternative SQLite for quick local dev:
# DATABASE_URL=sqlite:///./studygen.db

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
